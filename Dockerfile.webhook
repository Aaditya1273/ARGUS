# =============================================================================
# Dockerfile.webhook — SETU Webhook Server
# =============================================================================
# Single-stage build of the FastAPI webhook server only (no LangBot engine).
# Lightweight: python:3.12-slim + pip install from requirements.txt.
#
# Build:
#   docker build -f Dockerfile.webhook -t setu-webhook:latest .
#
# Run:
#   docker run --rm -p 9090:9090 --env-file .env setu-webhook:latest
# =============================================================================

ARG PYTHON_VERSION=3.12-slim

FROM python:${PYTHON_VERSION}

WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies (layer caching)
COPY plugins/seva_memory/requirements.txt ./plugins/seva_memory/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r ./plugins/seva_memory/requirements.txt

# Copy application code
COPY webhook_server.py .
COPY plugins/seva_memory/ ./plugins/seva_memory/

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=6 --start-period=20s \
    CMD curl -sf http://localhost:9090/health || exit 1

EXPOSE 9090

# Startup (ensure_all_collections() is called in __main__ block)
CMD ["uvicorn", "webhook_server:app", "--host", "0.0.0.0", "--port", "9090", "--log-level", "info"]
