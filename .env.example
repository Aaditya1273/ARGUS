# =============================================================================
# SETU — Field Memory Bridge  Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then start SETU:
#   docker compose up -d
#   # or: uv run uvicorn webhook_server:app --port 9090
#   # or: uv run main.py
# =============================================================================

# ----- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...                    # Required. GPT-4o, Whisper, embeddings.

# ----- Slack ------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...                 # Required. Bot token for posting messages.
SLACK_USER_TOKEN=xoxp-...                # Required for RTS search (user-level OAuth).
FIELD_OPS_CHANNEL=#field-ops             # Channel where field notes are posted.
SUMMARY_CHANNEL=#field-ops               # Channel for weekly summaries.
ADMIN_USER_IDS=U123456,U789012           # Comma-separated Slack user IDs for admin actions.

# ----- QDRANT VECTOR STORE --------------------------------------------------
QDRANT_URL=http://localhost:6333         # Qdrant instance URL.
QDRANT_API_KEY=                          # REQUIRED in production. Qdrant API key for authenticated access.
                                         # Generate: openssl rand -hex 32
                                         # If empty, Qdrant has NO authentication — anyone who reaches
                                         # port 6333 can read/write all data.

# ----- SETU API KEYS ----------------------------------------------------------
# REQUIRED in production. Without these, ALL API endpoints are accessible
# without authentication. Configure at least SETU_API_KEY.
# Generate: openssl rand -hex 32
SETU_API_KEY=                            # Full-access key (admin). Can read, write, delete, reset.
SETU_READ_API_KEY=                       # Read-only key. Can search, list, view stats.
SETU_WEBHOOK_API_KEY=                    # Webhook-only key. For WhatsApp/Slack integration endpoints.

# Optional: restrict admin access to specific IP ranges (CIDR notation, comma-separated)
# ADMIN_IP_RANGES=10.0.0.0/8,192.168.1.0/24
ADMIN_IP_RANGES=

# ----- LANGBOT CONFIGURATION --------------------------------------------------
LANGBOT_BOT_UUID=                        # UUID of the LangBot bot for webhook dispatch.
LANGBOT_API_URL=http://localhost:5300    # LangBot REST API base URL.
LANGBOT_API_KEY=                         # Optional API key for LangBot auth.

# ----- WEBHOOK SERVER ---------------------------------------------------------
WEBHOOK_SERVER_PORT=9090                 # Port for the FastAPI webhook server.
WEBHOOK_SECRET=                          # HMAC-SHA256 secret for webhook request verification.
                                         # Generate: openssl rand -hex 32
RATE_LIMIT_PER_MINUTE=120                # Max requests per minute per IP.

# ----- WHATSAPP (optional) ----------------------------------------------------
# Verify token set in WhatsApp Business API webhook configuration.
# Must match the value you configure in the WhatsApp Cloud API dashboard.
WHATSAPP_VERIFY_TOKEN=setu_verify_me

# WhatsApp Business API permanent access token (for media downloads).
# Requires the `whatsapp_business_messaging` and `whatsapp_business_media` scopes.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ----- LANGBOT CORE (optional overrides) --------------------------------------
# Leave these at defaults unless you need something different.
# LANGBOT_CONFIG_PATH=data/config.yaml
# LANGBOT_LOG_LEVEL=INFO
